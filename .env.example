# Space host, e.g. example.signalwire.com
SW_SPACE=example.signalwire.com
SW_PROJECT_ID=
# Project API token with the Voice scope. Server-side only; never send it to the browser.
SW_API_TOKEN=

# Public HTTPS base URL that reaches this server (e.g. your ngrok URL), no trailing slash
PUBLIC_URL=https://your-tunnel.example.com

# Room names. The transfer room must differ from the main room.
CONFERENCE_NAME=support-bridge-4
TRANSFER_CONFERENCE_NAME=support-bridge-4-transfer

# Caller ID for legs this server dials with the Calling API (a number in this project, E.164)
DIAL_FROM=

# Format of join_conference status callbacks: relay (JSON) or cxml (form-encoded)
STATUS_EVENT_TYPE=relay

# Audio for Park. Any public MP3 or WAV.
HOLD_MUSIC_URL=https://cdn.signalwire.com/default-music/welcome.mp3

# Optional HoldUrl for Compat Update a Participant (Hold=true). Leave empty for default hold music.
COMPAT_HOLD_URL=

PORT=3000
# Subscriber the browser signs in as, e.g. an email address. The server mints its SATs and the SDK refreshes them before expiry.
SUBSCRIBER_REFERENCE=
# Lifetime of each minted SAT in seconds (120 or more). Set low, e.g. 180, to watch a refresh happen.
SAT_TTL_SECONDS=3600
# true: request client-bound SATs (sat:refresh scope) so the SDK refreshes them itself
SAT_CLIENT_BOUND=false
